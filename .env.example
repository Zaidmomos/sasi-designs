# Copy these into Netlify: Site configuration → Environment variables.
# Never commit real values. This repo is public.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email alerts via SMTP (for Gmail: smtp.gmail.com, port 465, and a Google "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sasi Designs <you@gmail.com>
ALERT_EMAILS=owner1@example.com,owner2@example.com

# WhatsApp alerts via Meta WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=new_order_alert
WHATSAPP_TEMPLATE_LANG=en
ALERT_WHATSAPP_NUMBERS=919XXXXXXXXX,919XXXXXXXXX
